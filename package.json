{
  "name": "amino-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm exec turbo run build --no-daemon",
    "build:cli": "pnpm -F aminoui-cli build",
    "build:react": "pnpm -F @amino-ui/react build",
    "build:registry": "pnpm -F web build:registry",
    "dev": "pnpm exec turbo run dev --parallel",
    "dev:cli": "pnpm -F aminoui-cli dev",
    "start:cli": "pnpm -F aminoui-cli start:dev",
    "dev:web": "pnpm -F web dev",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:stylelint && pnpm check:contracts && pnpm check:typecheck",
    "check:contracts": "pnpm -r --if-present run check:contracts",
    "check:format": "pnpm format:check",
    "check:lint": "pnpm lint",
    "check:stylelint": "pnpm stylelint",
    "check:typecheck": "pnpm typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "preview": "pnpm exec turbo run preview --no-daemon",
    "typecheck": "pnpm -r typecheck",
    "stylelint": "pnpm -r stylelint",
    "format:write": "prettier --write package.json turbo.json tsconfig.json pnpm-workspace.yaml eslint.config.js prettier.config.mjs \"bin/**/*.{js,mjs,cjs}\" && pnpm -r format:write",
    "format:check": "prettier --check package.json turbo.json tsconfig.json pnpm-workspace.yaml eslint.config.js prettier.config.mjs \"bin/**/*.{js,mjs,cjs}\" && pnpm -r format:check",
    "test": "pnpm exec turbo run test --force --no-daemon",
    "precommit": "node bin/precommit-staged-workspaces.mjs",
    "precommit:root": "pnpm check"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@babel/core": "^7.24.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.0.11",
    "stylelint": "^16.3.1",
    "tsx": "^4.7.2",
    "turbo": "^1.13.2"
  },
  "devDependencies": {
    "@amino-ui/shared-utils": "workspace:*",
    "@types/node": "^20.12.5",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "prettier": "^3.8.1",
    "typescript": "^5.4.4"
  }
}
