{
  "name": "amino-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:cli": "pnpm -F aminoui-cli build",
    "build:registry": "pnpm -F web build:registry",
    "dev": "turbo run dev --parallel",
    "dev:cli": "pnpm -F aminoui-cli dev",
    "start:cli": "pnpm -F aminoui-cli start:dev",
    "dev:web": "pnpm -F web dev",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:stylelint && pnpm check:typecheck",
    "check:format": "pnpm format:check",
    "check:lint": "pnpm lint",
    "check:stylelint": "pnpm stylelint",
    "check:typecheck": "pnpm typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "stylelint": "turbo run stylelint",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "test": "turbo run test --force",
    "precommit": "lint-staged"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@babel/core": "^7.24.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "stylelint": "^16.3.1",
    "tsx": "^4.7.2",
    "turbo": "^1.13.2"
  },
  "devDependencies": {
    "@amino-ui/shared-utils": "workspace:*",
    "@types/node": "^20.12.5",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "prettier": "^3.8.1",
    "typescript": "^5.4.4"
  }
}
