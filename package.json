{
  "name": "codon-ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm exec turbo run build --no-daemon",
    "build:cli": "pnpm -F @codon-ui/cli build",
    "build:docs": "pnpm -F @codon-ui/docs build",
    "build:react": "pnpm -F @codon-ui/react build",
    "build:web": "pnpm -F web exec next build",
    "dev": "pnpm exec turbo run dev --parallel",
    "dev:cli": "pnpm -F @codon-ui/cli dev",
    "dev:docs": "pnpm -F @codon-ui/docs dev",
    "start:cli": "pnpm -F @codon-ui/cli start:dev",
    "dev:web": "pnpm -F web dev",
    "preview:docs": "pnpm -F @codon-ui/docs preview",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:stylelint && pnpm check:contracts && pnpm check:typecheck",
    "check:contracts": "pnpm -r --if-present run check:contracts",
    "check:format": "pnpm format:check",
    "check:lint": "pnpm lint",
    "check:stylelint": "pnpm stylelint",
    "check:typecheck": "pnpm typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "preview": "pnpm exec turbo run preview --no-daemon",
    "typecheck": "pnpm -r typecheck",
    "stylelint": "pnpm -r stylelint",
    "format:write": "prettier --write package.json turbo.json tsconfig.json pnpm-workspace.yaml eslint.config.js prettier.config.mjs README.md AGENTS.md \"docs/**/*.md\" \"bin/**/*.{js,mjs,cjs}\" && pnpm -r format:write",
    "format:check": "prettier --check package.json turbo.json tsconfig.json pnpm-workspace.yaml eslint.config.js prettier.config.mjs README.md AGENTS.md \"docs/**/*.md\" \"bin/**/*.{js,mjs,cjs}\" && pnpm -r format:check",
    "test": "pnpm verify:tests",
    "verify:build": "bash bin/verify-monorepo-build.sh",
    "verify:ci": "pnpm verify:github-actions && pnpm verify:tooling && pnpm verify:build && pnpm verify:tests",
    "verify:github-actions": "bash bin/verify-github-actions.sh",
    "verify:tests": "bash bin/verify-monorepo-tests.sh",
    "verify:tooling": "bash bin/verify-monorepo-tooling.sh",
    "precommit": "node bin/precommit-staged-workspaces.mjs",
    "precommit:root": "pnpm check"
  },
  "packageManager": "pnpm@10.18.3",
  "dependencies": {
    "@babel/core": "^7.24.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "husky": "^9.0.11",
    "stylelint": "^16.3.1",
    "tsx": "^4.7.2",
    "turbo": "^1.13.2"
  },
  "devDependencies": {
    "@codon-ui/shared-utils": "workspace:*",
    "@types/node": "^20.12.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "^3.8.1",
    "typescript": "^5.4.4"
  }
}
