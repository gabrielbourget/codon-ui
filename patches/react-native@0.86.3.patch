+static inline NSSet<UIPress *> *RCTTextInputRemainingPresses(
+    UIView *view, NSSet<UIPress *> *presses, NSString *phase, RCTTextInputPressHandler _Nullable handler)
+{
+  if (!handler) return presses;
+  NSMutableSet<UIPress *> *remaining = nil;
+  for (UIPress *press in presses) {
+    if (!handler(view, press, phase)) continue;
+    if (!remaining) remaining = [presses mutableCopy];
+    [remaining removeObject:press];
+  }
+  return remaining ?: presses;
+}
+
 NS_ASSUME_NONNULL_END
