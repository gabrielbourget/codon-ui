+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This source code is licensed under the MIT license found in the
+ * LICENSE file in the root directory of this source tree.
+ */
+
+package com.facebook.react.views.text
+
+import android.graphics.Paint
+import android.graphics.fonts.FontVariationAxis
+import android.os.Build
+import java.util.WeakHashMap
+
+/** Scalar transport remains exact; native face matching remains the original peer policy. */
+public object ReactFontWeightScalar {
+  private data class Applied(val baseline: String?, val settings: String)
+  private val applied = WeakHashMap<Paint, Applied>()
+
+  @JvmStatic
+  public fun parse(value: String?): Double {
+    val scalar = when (value) {
+      "normal", "regular" -> 400.0
+      "bold" -> 700.0
+      else -> value?.toDoubleOrNull() ?: Double.NaN
+    }
+    return if (scalar.isFinite() && scalar >= 1 && scalar <= 1000) scalar else Double.NaN
+  }
+
+  /** Replaces only the owned wght entry; removal restores the prior original Paint settings. */
+  @JvmStatic
+  public fun apply(paint: Paint, scalar: Double): Boolean {
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return false
+    synchronized(applied) {
+      val old = applied[paint]
+      val current = paint.fontVariationSettings
+      val baseline = if (old != null && current == old.settings) old.baseline else current
+      if (!scalar.isFinite()) {
+        if (old != null && current == old.settings) paint.setFontVariationSettings(baseline)
+        applied.remove(paint)
+        return false
+      }
+      val axes = FontVariationAxis.fromFontVariationSettings(baseline)?.toMutableList() ?: mutableListOf()
+      axes.removeAll { it.tag == "wght" }
+      axes.add(FontVariationAxis("wght", scalar.toFloat()))
+      val settings = FontVariationAxis.toFontVariationSettings(axes.toTypedArray())
+      val accepted = paint.setFontVariationSettings(settings)
+      if (accepted) applied[paint] = Applied(baseline, settings)
+      else {
+        if (old != null && current == old.settings) paint.setFontVariationSettings(baseline)
+        applied.remove(paint)
+      }
+      return accepted
+    }
+  }
+}
