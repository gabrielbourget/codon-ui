--- /dev/null
+++ b/ReactCommon/react/renderer/components/textinput/CuiTextSnapshot.cpp
@@ -0,0 +1,88 @@
+#include "CuiTextSnapshot.h"
+#include <atomic>
+#include <mutex>
+#include <stdexcept>
+#include <unordered_map>
+
+namespace facebook::react {
+namespace {
+class Source final : public CuiTextSnapshotSource {
+ public:
+  const Tag target;
+  const uint64_t owner;
+  const CuiTextSnapshotCapture capture;
+  std::atomic<bool> active{true};
+  Source(Tag target, uint64_t owner, CuiTextSnapshotCapture capture)
+      : target(target), owner(owner), capture(std::move(capture)) {}
+  std::shared_ptr<const CuiTextSnapshot> read() const override {
+    std::lock_guard lock(mutex_);
+    if (!active.load() || !latest_) throw std::runtime_error("Native text snapshot is unavailable or retired");
+    if (!latest_->failure.empty()) throw std::runtime_error(latest_->failure);
+    return latest_;
+  }
+  bool current(const std::shared_ptr<const CuiTextSnapshot> &snapshot) const override {
+    std::lock_guard lock(mutex_);
+    return active.load() && snapshot && latest_ == snapshot && snapshot->failure.empty();
+  }
+  bool publish(std::shared_ptr<const void> payload, std::string failure) {
+    std::lock_guard lock(mutex_);
+    if (!active.load()) return false;
+    if (!payload && failure.empty()) failure = "Native text snapshot source returned no owned payload";
+    latest_ = std::make_shared<const CuiTextSnapshot>(CuiTextSnapshot{++version_,std::move(payload),std::move(failure)});
+    return true;
+  }
+ private:
+  mutable std::mutex mutex_;
+  uint64_t version_{0};
+  std::shared_ptr<const CuiTextSnapshot> latest_;
+};
+std::mutex registryMutex;
+std::unordered_map<Tag,std::weak_ptr<Source>> registry;
+class Registration final : public CuiTextSnapshotRegistration {
+ public:
+  explicit Registration(std::shared_ptr<Source> source) : source_(std::move(source)) {}
+  ~Registration() override { dispose(); }
+  std::shared_ptr<const CuiTextSnapshotSource> source() const override { return source_; }
+  void dispose() noexcept override { source_->active.store(false); }
+ private:
+  std::shared_ptr<Source> source_;
+};
+std::shared_ptr<Source> findSource(Tag target) {
+  std::lock_guard lock(registryMutex);
+  auto found = registry.find(target);
+  auto result = found == registry.end() ? nullptr : found->second.lock();
+  return result && result->active.load() ? result : nullptr;
+}
+}
+std::shared_ptr<CuiTextSnapshotRegistration> registerCuiTextSnapshotSource(
+    Tag target, uint64_t owner, CuiTextSnapshotCapture capture) {
+  if (target <= 0 || owner == 0) throw std::invalid_argument("Original native text target/owner required");
+  auto source = std::make_shared<Source>(target,owner,std::move(capture));
+  {
+    std::lock_guard lock(registryMutex);
+    for (auto entry=registry.begin();entry!=registry.end();) {
+      if (entry->second.expired()) entry=registry.erase(entry);
+      else ++entry;
+    }
+    auto previous = registry[target].lock();
+    if (previous) previous->active.store(false);
+    registry[target] = source;
+  }
+  return std::make_shared<Registration>(std::move(source));
+}
+std::shared_ptr<const CuiTextSnapshotSource> findCuiTextSnapshotSource(Tag target) { return findSource(target); }
+std::shared_ptr<const CuiTextSnapshotSource> captureCuiTextSnapshot(Tag target, std::shared_ptr<void> original) {
+  auto source = findSource(target);
+  if (!source) return nullptr;
+  try {
+    if (!source->capture) throw std::runtime_error("Native text snapshot producer unavailable");
+    source->publish(source->capture(std::move(original)),{});
+  } catch (const std::exception &failure) { source->publish({},failure.what()); }
+  catch (...) { source->publish({},"Native text snapshot producer failed"); }
+  return source;
+}
+bool publishCuiTextSnapshot(Tag target, uint64_t owner, std::shared_ptr<const void> ownedPayload, std::string failure) {
+  auto source = findSource(target);
+  return source && source->owner == owner && source->publish(std::move(ownedPayload),std::move(failure));
+}
+}
