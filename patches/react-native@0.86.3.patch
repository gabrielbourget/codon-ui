+/* Copyright (c) Meta Platforms, Inc. and affiliates. MIT; see LICENSE. */
+package com.facebook.react.uimanager;
+
+import android.os.Looper;
+import android.view.View;
+import androidx.core.view.accessibility.AccessibilityNodeInfoCompat;
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+
+/** Opt-in read-time projection. Original view properties, nodes and delegates remain owned. */
+public final class ReactAccessibilityProjection {
+  public static final int ORIGINAL=0, ALLOWED=1, TRAVERSE=2, EXCLUDED=3;
+  public interface Receiver {
+    int mode(View view);
+    void projectChildren(View host,ArrayList<View> original,int start);
+  }
+  private static WeakReference<Receiver> receiver=new WeakReference<>(null);
+  private static final ThreadLocal<Integer> originalDepth=new ThreadLocal<Integer>() {
+    @Override protected Integer initialValue() { return 0; }
+  };
+  private ReactAccessibilityProjection() {}
+  public static void beginOriginalMetadata() { originalDepth.set(originalDepth.get()+1); }
+  public static void endOriginalMetadata() {
+    int depth=originalDepth.get();
+    if (depth<1) throw new IllegalStateException("Original accessibility metadata scope is unbalanced");
+    originalDepth.set(depth-1);
+  }
+  public static boolean register(Receiver value) {
+    if (Looper.myLooper()!=Looper.getMainLooper()) throw new IllegalStateException("Accessibility projection registration requires the UI thread");
+    Receiver current=receiver.get(); if (current!=null && current!=value) return false;
+    receiver=new WeakReference<>(value); return true;
+  }
+  public static int mode(View view) { if (originalDepth.get()>0) return ORIGINAL; Receiver value=receiver.get(); return value==null?ORIGINAL:value.mode(view); }
+  public static void projectChildren(View host,ArrayList<View> original,int start) {
+    Receiver value=receiver.get(); if (value!=null && originalDepth.get()==0) value.projectChildren(host,original,start);
+  }
+  public static void projectNode(View host,AccessibilityNodeInfoCompat original) {
+    int mode=mode(host);
+    if (mode==TRAVERSE || mode==EXCLUDED) { original.setScreenReaderFocusable(false); original.setFocusable(false); }
+    if (mode==EXCLUDED) { original.setVisibleToUser(false); original.setImportantForAccessibility(false); }
+  }
+  public static boolean allowsAction(View view) { Receiver current=receiver.get(); int mode=current==null?ORIGINAL:current.mode(view); return mode==ORIGINAL || mode==ALLOWED; }
+}
