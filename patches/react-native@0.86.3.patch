+/* Copyright (c) Meta Platforms, Inc. and affiliates. MIT; see LICENSE. */
+#import <UIKit/UIKit.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+typedef NS_ENUM(NSInteger, RCTAccessibilityProjectionMode) {
+  RCTAccessibilityProjectionOriginal,
+  RCTAccessibilityProjectionAllowed,
+  RCTAccessibilityProjectionTraverse,
+  RCTAccessibilityProjectionExcluded,
+};
+
+// A receiver reads current ownership only. It must never change a view or invoke JavaScript.
+@protocol RCTAccessibilityProjectionReceiver <NSObject>
+- (RCTAccessibilityProjectionMode)accessibilityProjectionForView:(UIView *)view;
+- (NSArray *)projectAccessibilityChildren:(NSArray *)children container:(id)container view:(UIView *)view;
+@end
+
+// Scoped original metadata reads preserve nested label/value construction. These are not view mutations.
+FOUNDATION_EXPORT id _Nullable RCTReadOriginalAccessibilityValue(id _Nullable (^reader)(void));
+FOUNDATION_EXPORT BOOL RCTReadOriginalAccessibilityBoolean(BOOL (^reader)(void));
+FOUNDATION_EXPORT BOOL RCTRegisterAccessibilityProjectionReceiver(id<RCTAccessibilityProjectionReceiver> receiver);
+FOUNDATION_EXPORT RCTAccessibilityProjectionMode RCTAccessibilityProjectionForView(UIView *view);
+FOUNDATION_EXPORT BOOL RCTProjectAccessibilityElement(UIView *view, BOOL original);
+FOUNDATION_EXPORT BOOL RCTProjectAccessibilityHidden(UIView *view, BOOL original);
+FOUNDATION_EXPORT NSArray *_Nullable RCTProjectAccessibilityChildren(UIView *view, id container, NSArray *_Nullable original);
+FOUNDATION_EXPORT BOOL RCTAccessibilityProjectionAllowsAction(UIView *view);
+
+NS_ASSUME_NONNULL_END
diff --git a/React/Base/RCTAccessibilityProjection.mm b/React/Base/RCTAccessibilityProjection.mm
new file mode 100644
index 0000000000000000000000000000000000000000..615a2009a4337eabd9abdee8975241f1fb412a64
--- /dev/null
+++ b/React/Base/RCTAccessibilityProjection.mm
@@ -0,0 +1,50 @@
+/* Copyright (c) Meta Platforms, Inc. and affiliates. MIT; see LICENSE. */
+#import "RCTAccessibilityProjection.h"
+
+static __weak id<RCTAccessibilityProjectionReceiver> RCTProjectionReceiver;
+static thread_local NSUInteger RCTOriginalAccessibilityDepth;
+id RCTReadOriginalAccessibilityValue(id (^reader)(void))
+{
+  RCTOriginalAccessibilityDepth++;
+  @try { return reader(); } @finally { RCTOriginalAccessibilityDepth--; }
+}
+BOOL RCTReadOriginalAccessibilityBoolean(BOOL (^reader)(void))
+{
+  RCTOriginalAccessibilityDepth++;
+  @try { return reader(); } @finally { RCTOriginalAccessibilityDepth--; }
+}
+
+BOOL RCTRegisterAccessibilityProjectionReceiver(id<RCTAccessibilityProjectionReceiver> receiver)
+{
+  NSCAssert(NSThread.isMainThread, @"Accessibility projection registration requires the main thread");
+  if (RCTProjectionReceiver && RCTProjectionReceiver != receiver) return NO;
+  RCTProjectionReceiver = receiver;
+  return YES;
+}
+RCTAccessibilityProjectionMode RCTAccessibilityProjectionForView(UIView *view)
+{
+  if (RCTOriginalAccessibilityDepth) return RCTAccessibilityProjectionOriginal;
+  id<RCTAccessibilityProjectionReceiver> receiver = RCTProjectionReceiver;
+  return receiver ? [receiver accessibilityProjectionForView:view] : RCTAccessibilityProjectionOriginal;
+}
+BOOL RCTProjectAccessibilityElement(UIView *view, BOOL original)
+{
+  RCTAccessibilityProjectionMode mode = RCTAccessibilityProjectionForView(view);
+  return mode == RCTAccessibilityProjectionTraverse || mode == RCTAccessibilityProjectionExcluded ? NO : original;
+}
+BOOL RCTProjectAccessibilityHidden(UIView *view, BOOL original)
+{
+  return RCTAccessibilityProjectionForView(view) == RCTAccessibilityProjectionExcluded ? YES : original;
+}
+NSArray *RCTProjectAccessibilityChildren(UIView *view, id container, NSArray *original)
+{
+  id<RCTAccessibilityProjectionReceiver> receiver = RCTProjectionReceiver;
+  if (!receiver || RCTAccessibilityProjectionForView(view) == RCTAccessibilityProjectionOriginal) return original;
+  return [receiver projectAccessibilityChildren:original ?: view.subviews container:container view:view];
+}
+BOOL RCTAccessibilityProjectionAllowsAction(UIView *view)
+{
+  id<RCTAccessibilityProjectionReceiver> receiver = RCTProjectionReceiver;
+  RCTAccessibilityProjectionMode mode = receiver ? [receiver accessibilityProjectionForView:view] : RCTAccessibilityProjectionOriginal;
+  return mode == RCTAccessibilityProjectionOriginal || mode == RCTAccessibilityProjectionAllowed;
+}
