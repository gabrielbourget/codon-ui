+ * LICENSE file in the root directory of this source tree.
+ */
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+
+namespace facebook::react {
+// Tracks SDK listener stacks on this thread, including a different manager.
+// It is a lock-safety guard, not an event admission or feature switch.
+class NativeEventListenerScope final {
+ public:
+  NativeEventListenerScope();
+  ~NativeEventListenerScope();
+  NativeEventListenerScope(const NativeEventListenerScope &) = delete;
+  NativeEventListenerScope &operator=(const NativeEventListenerScope &) = delete;
+  static bool active();
+};
+
+// Claimed on the original event stack, invoked only after the listener lock.
+// Callback completion is not a JS delivery, focus or native-default receipt.
+class NativeEventContinuation final {
+ public:
+  explicit NativeEventContinuation(std::function<void()> callback)
+      : thread_(std::this_thread::get_id()), callback_(std::move(callback)) {
+    if (!callback_) throw std::invalid_argument("native-event-continuation-required");
+  }
+  void run() {
+    if (NativeEventListenerScope::active())
+      throw std::runtime_error("native-event-continuation-listener-stack-active");
+    if (thread_ != std::this_thread::get_id())
+      throw std::runtime_error("native-event-continuation-wrong-thread");
+    bool expected = false;
+    if (!claimed_.compare_exchange_strong(expected, true)) return;
+    auto callback = std::move(callback_);
+    callback();
+  }
+ private:
+  const std::thread::id thread_;
+  std::atomic<bool> claimed_{false};
+  std::function<void()> callback_;
+};
+} // namespace facebook::react
