+package com.facebook.react.fabric.mounting
+
+import android.os.SystemClock
+import com.facebook.react.bridge.RetryableMountingLayerException
+import com.facebook.react.bridge.UiThreadUtil
+import com.facebook.react.fabric.mounting.mountitems.DispatchCommandMountItem
+import java.util.function.BooleanSupplier
+
+// Owns the original item, including the dispatcher's existing retry policy.
+// A retired item may remain in a normal SDK queue but cannot execute later.
+public class NativeEventCommandScope internal constructor(
+    private val dispatcher: MountItemDispatcher,
+    private val surfaceId: Int,
+    private val deadline: Long,
+    private val current: BooleanSupplier,
+) : AutoCloseable {
+  private var captured = false
+  private var closed = false
+  private var executed = false
+  private var error = ""
+  private var attempts = 0
+
+  internal fun capture(original: DispatchCommandMountItem): DispatchCommandMountItem {
+    check(!captured && !closed) { "native-event-command-capture-count" }
+    check(original.getSurfaceId() == surfaceId) { "native-event-command-surface-mismatch" }
+    captured = true
+    return object : DispatchCommandMountItem() {
+      override fun getSurfaceId(): Int = original.getSurfaceId()
+      override fun toString(): String = original.toString()
+      override fun execute(mountingManager: MountingManager) {
+        if (closed || executed || error.isNotEmpty()) return
+        if (!isCurrent()) { reject("native-event-command-retired"); return }
+        // The wrapper is the queued item; retain the original item's retry
+        // count as the existing dispatcher advances that same operation.
+        while (original.getRetries() < getRetries()) original.incrementRetries()
+        attempts++
+        try {
+          original.execute(mountingManager)
+          executed = true
+        } catch (failure: RetryableMountingLayerException) {
+          if (getRetries() != 0) reject(failure.message ?: "native-event-command-retry-exhausted")
+          throw failure
+        } catch (failure: Throwable) {
+          reject(failure.message ?: "native-event-command-failed")
+          throw failure
+        }
+      }
+    }
+  }
+
+  private fun isCurrent(): Boolean =
+      !closed && SystemClock.uptimeMillis() < deadline && current.asBoolean &&
+          dispatcher.nativeEventSurfaceCurrent(surfaceId)
+
+  private fun reject(reason: String) { if (error.isEmpty()) error = reason }
+
+  public fun finishAndDrain(): Boolean {
+    UiThreadUtil.assertOnUiThread()
+    dispatcher.endNativeEventCapture(this)
+    if (!captured) reject("native-event-command-not-captured")
+    try {
+      while (!closed && !executed && error.isEmpty()) {
+        if (!isCurrent()) { reject("native-event-command-retired"); break }
+        val before = attempts
+        dispatcher.drainNativeEventCommands()
+        if (!executed && error.isEmpty() && attempts == before) {
+          reject("native-event-command-no-progress")
+        }
+      }
+      if (executed && !isCurrent()) reject("native-event-command-retired-after-execution")
+      return executed && error.isEmpty()
+    } finally {
+      close()
+    }
+  }
+
+  public fun wasExecuted(): Boolean = executed
+  public fun getError(): String = error
+
+  override fun close() {
+    UiThreadUtil.assertOnUiThread()
+    closed = true
+    dispatcher.endNativeEventCapture(this)
+  }
+}
