+    Registration(std::shared_ptr<State> state, std::shared_ptr<Entry> entry) : state_(std::move(state)), entry_(std::move(entry)) {}
+    ~Registration() { retire(); }
+    Registration(const Registration &) = delete;
+    Registration &operator=(const Registration &) = delete;
+    void retire() {
+      entry_->active.store(false);
+      std::lock_guard lock(state_->mutex);
+      auto &entries = state_->entries;
+      for (auto it = entries.begin(); it != entries.end(); ++it) if (*it == entry_) { entries.erase(it); break; }
+    }
+   private:
+    std::shared_ptr<State> state_;
+    std::shared_ptr<Entry> entry_;
+  };
+  NativeEventPayloads() : state_(std::make_shared<State>()) {}
+  ~NativeEventPayloads() {
+    std::lock_guard lock(state_->mutex);
+    state_->live = false;
+    for (const auto &entry : state_->entries) entry->active.store(false);
+  }
+  NativeEventPayloads(const NativeEventPayloads &) = delete;
+  NativeEventPayloads &operator=(const NativeEventPayloads &) = delete;
+  std::shared_ptr<Registration> enter(Handler handler) {
+    if (!handler) throw std::invalid_argument("native-event-payload-handler-required");
+    auto entry = std::make_shared<Entry>(std::move(handler));
+    auto registration = std::make_shared<Registration>(state_, entry);
+    std::lock_guard lock(state_->mutex);
+    if (!state_->live) throw std::runtime_error("native-event-payload-binding-retired");
+    state_->entries.push_back(entry);
+    return registration;
+  }
+  Completion before(jsi::Runtime &runtime, EventTarget *target, const std::string &type, jsi::Value &payload) const {
+    std::shared_ptr<Entry> selected;
+    {
+      std::lock_guard lock(state_->mutex);
+      if (!state_->live) return {};
+      for (auto it = state_->entries.rbegin(); it != state_->entries.rend(); ++it)
+        if ((*it)->active.load() && (*it)->thread == std::this_thread::get_id()) { selected = *it; break; }
+    }
+    return selected && selected->active.load() ? selected->handler(runtime, target, type, payload) : Completion{};
+  }
+ private:
+  std::shared_ptr<State> state_;
+};
+} // namespace facebook::react
