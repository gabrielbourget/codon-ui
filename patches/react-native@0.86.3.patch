--- /dev/null
+++ b/ReactCommon/react/renderer/attributedstring/TextStyleFields.h
@@ -0,0 +1,18 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <string_view>
+
+namespace facebook::react {
+inline constexpr std::array<std::string_view,23> TextStyleFieldNames = {
+  "color", "fontFamily", "fontSize", "fontWeight", "fontStyle", "fontVariant", "letterSpacing", "lineHeight",
+  "textAlign", "textAlignVertical", "includeFontPadding", "textDecorationLine", "textDecorationStyle",
+  "textDecorationColor", "textShadowColor", "textShadowOffset", "textShadowRadius", "textTransform", "writingDirection",
+  "selectable", "fontSizeMultiplier", "allowFontScaling", "maxFontSizeMultiplier"
+};
+inline uint64_t textStyleFieldBit(std::string_view name) {
+  for (size_t index=0;index<TextStyleFieldNames.size();index++)
+    if (TextStyleFieldNames[index]==name) return uint64_t{1}<<index;
+  return 0;
+}
+}
