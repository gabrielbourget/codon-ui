diff --git a/ReactCommon/react/renderer/attributedstring/FontWeightScalar.h b/ReactCommon/react/renderer/attributedstring/FontWeightScalar.h
new file mode 100644
index 0000000000000000000000000000000000000000..77ebe387c80984230850511f7bedd55fb236afbe
--- /dev/null
+++ b/ReactCommon/react/renderer/attributedstring/FontWeightScalar.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <limits>
+#include <locale>
+#include <sstream>
+#include <string>
+
+namespace facebook::react {
+inline double parseFontWeightScalar(const std::string &value) {
+  if (value == "normal" || value == "regular") return 400;
+  if (value == "bold") return 700;
+  std::istringstream parser(value);
+  parser.imbue(std::locale::classic());
+  double scalar = std::numeric_limits<double>::quiet_NaN();
+  parser >> std::noskipws >> scalar;
+  return parser && parser.eof() && std::isfinite(scalar) && scalar >= 1 && scalar <= 1000
+      ? scalar : std::numeric_limits<double>::quiet_NaN();
+}
+inline bool fontWeightScalarEqual(double first, double second) {
+  return first == second || (std::isnan(first) && std::isnan(second));
+}
+template <typename TWeight>
+inline TWeight interpolateFontWeight(double scalar, const std::array<TWeight, 9> &weights) {
+  const double position = std::clamp((scalar-100)/100,0.0,8.0);
+  const auto first = static_cast<size_t>(std::floor(position));
+  const auto last = std::min(first+1,weights.size()-1);
+  return weights[first]+(weights[last]-weights[first])*(position-first);
+}
+}
