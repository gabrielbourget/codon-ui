+    if (!claimed_.compare_exchange_strong(expected, true)) return;
+    auto callback = std::move(callback_);
+    try { if (callback) callback(); }
+    catch (const std::exception &error) { if (auto scope = scope_.lock()) scope->fail(error.what()); throw; }
