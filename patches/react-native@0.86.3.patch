+#include <string>
+
+namespace facebook::jsi { class Runtime; }
+namespace facebook::react {
+// One original task owns this scope through its real microtask checkpoint and
+// rendering updates. Completion is not evidence of any native platform effect.
+class NativeEventTaskScope {
+ public:
+  virtual ~NativeEventTaskScope() = default;
+  virtual void fail(const std::string &error) noexcept = 0;
+  virtual void finish() noexcept = 0;
+};
+// The ordinary rendering queue retains its front callback when it throws.
+// Copies of an admitted task's queue item must still own only one invocation.
+class NativeEventTaskRenderingUpdate final {
+ public:
+  NativeEventTaskRenderingUpdate(std::function<void()> callback, std::weak_ptr<NativeEventTaskScope> scope)
+      : callback_(std::move(callback)), scope_(std::move(scope)) {}
+  void run() {
+    bool expected = false;
+    if (!claimed_.compare_exchange_strong(expected, true)) return;
+    auto callback = std::move(callback_);
+    try { if (callback) callback(); }
+    catch (const std::exception &error) { if (auto scope = scope_.lock()) scope->fail(error.what()); throw; }
+    catch (...) { if (auto scope = scope_.lock()) scope->fail("native-event-task-rendering-threw"); throw; }
+  }
+ private:
+  std::atomic<bool> claimed_{false};
+  std::function<void()> callback_;
+  std::weak_ptr<NativeEventTaskScope> scope_;
+};
+using NativeEventTaskScopeFactory = std::function<std::shared_ptr<NativeEventTaskScope>(jsi::Runtime &)>;
+} // namespace facebook::react
