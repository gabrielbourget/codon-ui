{
  "name": "@codon-ui/native-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "bundle:ios": "expo export --platform ios --output-dir dist/ios",
    "bundle:android": "expo export --platform android --output-dir dist/android",
    "check:dependencies": "expo install --check && expo-doctor",
    "test": "jest --config jest.config.cjs",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "precommit": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@codon-ui/react-native": "workspace:*",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@formatjs/intl-numberformat": "9.4.3",
    "@formatjs/intl-pluralrules": "6.3.15",
    "expo": "57.0.26",
    "expo-dev-client": "57.0.19",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@codon-ui/shared-utils": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "eslint": "9.39.4",
    "jest": "29.7.0",
    "prettier": "3.8.3",
    "test-renderer": "1.2.0",
    "typescript": "5.9.3",
    "babel-preset-expo": "57.0.13",
    "expo-doctor": "1.20.4",
    "jest-expo": "57.0.5"
  }
}
