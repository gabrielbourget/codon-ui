{
  "name": "aminoui-cli",
  "description": "Distribute centralized resources into your codebase in a modular fashion.",
  "module": "./dist/index.js",
  "type": "module",
  "exports": "./dist/index.js",
  "bin": "./dist/index.js",
  "version": "0.0.1",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start:dev": "cross-env COMPONENTS_REGISTRY_URL=http://localhost:3001 node dist/index.js",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --cache",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --cache",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,ts}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{json,ts}\"",
    "precommit": "pnpm format:check && pnpm lint && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no tests specified\" && exit 1",
    "pub:beta": "npm build && npm publish --access public --tag beta",
    "pub:next": "npm build && npm publish --access public --tag next",
    "pub:release": "npm build && npm publish --access public"
  },
  "dependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-typescript": "^7.24.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "cross-env": "^7.0.3",
    "detect-package-manager": "^3.0.1",
    "diff": "^5.2.0",
    "execa": "^8.0.1",
    "fast-glob": "^3.3.2",
    "figlet": "^1.7.0",
    "fs-extra": "^11.2.0",
    "https-proxy-agent": "^7.0.4",
    "ora": "^8.0.1",
    "path": "^0.12.7",
    "prompts": "^2.4.2",
    "recast": "^0.23.6",
    "rimraf": "^5.0.5",
    "ts-morph": "^22.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@amino-ui/shared-utils": "workspace:*",
    "@types/diff": "^5.0.9",
    "@types/figlet": "^1.5.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.2",
    "@types/prompts": "^2.4.9",
    "bun-types": "latest",
    "eslint": "^9.0.0",
    "prettier": "^3.8.1",
    "tsup": "^8.0.2",
    "type-fest": "^4.14.0",
    "typescript": "^5.4.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
